+    // @see docs/specs/tone3000-gig-rig/tone3000-gig-rig.md [FR-4] [DES-UI] [2.8]
+    static bool isWellFormedObject (const LV2_Atom_Event* event) noexcept
+    {
+        if (event->body.size < sizeof (LV2_Atom_Object_Body))
+            return false;
+        auto* cursor = reinterpret_cast<const uint8_t*> (event + 1) + sizeof (LV2_Atom_Object_Body);
+        auto remaining = (size_t) event->body.size - sizeof (LV2_Atom_Object_Body);
+        while (remaining != 0)
+        {
+            if (remaining < sizeof (LV2_Atom_Property_Body))
+                return false;
+            const auto* property = reinterpret_cast<const LV2_Atom_Property_Body*> (cursor);
+            const auto paddedValueSize = ((size_t) property->value.size + 7u) & ~(size_t) 7u;
+            if (paddedValueSize > remaining - sizeof (LV2_Atom_Property_Body))
+                return false;
+            const auto propertySize = sizeof (LV2_Atom_Property_Body) + paddedValueSize;
+            cursor += propertySize;
+            remaining -= propertySize;
+        }
+        return true;
+    }
+
+    // Objects have already passed the structural bounds check above.
+    // @see docs/specs/tone3000-gig-rig/tone3000-gig-rig.md [FR-4] [DES-UI] [2.8]
+    void processPatchGet (const LV2_Atom_Event* event) noexcept
+    {
+        if (event->body.type != patchSetHelper.mLV2_ATOM__Object)
+            return;
+        const auto* object = reinterpret_cast<const LV2_Atom_Object*> (&event->body);
+        if (object->body.otype != mLV2_PATCH__Get)
+            return;
+        const LV2_Atom* subject = nullptr;
+        const LV2_Atom* property = nullptr;
+        auto* cursor = reinterpret_cast<const uint8_t*> (&object->body + 1);
+        auto remaining = (size_t) object->atom.size - sizeof (LV2_Atom_Object_Body);
+        while (remaining != 0)
+        {
+            const auto* entry = reinterpret_cast<const LV2_Atom_Property_Body*> (cursor);
+            if (entry->key == patchSetHelper.mLV2_PATCH__subject)
+            {
+                if (subject != nullptr) return;
+                subject = &entry->value;
+            }
+            else if (entry->key == patchSetHelper.mLV2_PATCH__property)
+            {
+                if (property != nullptr) return;
+                property = &entry->value;
+            }
+            const auto propertySize = sizeof (LV2_Atom_Property_Body) + (((size_t) entry->value.size + 7u) & ~(size_t) 7u);
+            cursor += propertySize;
+            remaining -= propertySize;
+        }
+        const auto isUrid = [this] (const LV2_Atom* atom)
+        {
+            return atom->type == patchSetHelper.mLV2_ATOM__URID && atom->size == sizeof (LV2_URID);
+        };
+        if (subject != nullptr && (! isUrid (subject)
+            || readUnaligned<LV2_URID> (subject + 1) != patchSetHelper.pluginUrid))
+            return;
+        if (property == nullptr)
+            parameters.requestAllValuesFromHost();
+        else if (isUrid (property))
+            parameters.requestValueFromHost (readUnaligned<LV2_URID> (property + 1));
+    }
