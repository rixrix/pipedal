@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

# @see docs/specs/tone3000-gig-rig/tone3000-gig-rig.md [FR-27] [DES-PITCH-LV2] [7.35]
<https://github.com/rixrix/pipedal/plugins/t3k-pitch#mono> a lv2:Plugin, lv2:PitchPlugin ;
    doap:name "T3K Pitch (Mono)" ; doap:license <https://www.gnu.org/licenses/agpl-3.0.html> ;
    rdfs:comment "Independent pinned TONE3000 pitch engine. Tonality 20000 Hz is off. Powered-on zero semitones retains the engine delay; Enabled off fades to dry. Reported latency is a configured convention, not measured interface latency. Supported sample rates 44100–192000 Hz." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature opts:options, urid:map ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "enabled" ; lv2:name "Enabled" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "semitones" ; lv2:name "Semitones" ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:default 0 ; units:unit units:semitone12TET ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "step" ; lv2:name "Step" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 1 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "tonality" ; lv2:name "Tonality (top = off)" ; lv2:minimum 1000 ; lv2:maximum 20000 ; lv2:default 20000 ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "window" ; lv2:name "Buffer" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "20 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "30 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "40 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "60 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ] ],
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Reported latency" ; lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ; units:unit units:frame ; lv2:minimum 0 ; lv2:maximum 5952 ; lv2:default 0 ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "input_mode" ; lv2:name "Input" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Stereo" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Left" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Right" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 7 ; lv2:symbol "in_l" ; lv2:name "Input" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 8 ; lv2:symbol "out_l" ; lv2:name "Output" ] .

<https://github.com/rixrix/pipedal/plugins/t3k-pitch#stereo> a lv2:Plugin, lv2:PitchPlugin ;
    doap:name "T3K Pitch (Stereo)" ; doap:license <https://www.gnu.org/licenses/agpl-3.0.html> ;
    rdfs:comment "Shared stereo control/tap, separate channel rings. Input Left or Right duplicates that source before pitch; Stereo preserves both channels. Same controls and sample-rate limits as the mono variant. Serial pitch latencies add; inverse shifts do not promise exact recovery." ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ; lv2:optionalFeature opts:options, urid:map ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "enabled" ; lv2:name "Enabled" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "semitones" ; lv2:name "Semitones" ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:default 0 ; units:unit units:semitone12TET ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "step" ; lv2:name "Step" ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 1 ; lv2:portProperty lv2:toggled, lv2:integer ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "tonality" ; lv2:name "Tonality (top = off)" ; lv2:minimum 1000 ; lv2:maximum 20000 ; lv2:default 20000 ; units:unit units:hz ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "window" ; lv2:name "Buffer" ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:default 1 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "20 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "30 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "40 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ], [ rdfs:label "60 ms" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ] ],
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Reported latency" ; lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ; units:unit units:frame ; lv2:minimum 0 ; lv2:maximum 5952 ; lv2:default 0 ],
      [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "input_mode" ; lv2:name "Input" ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:default 0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Stereo" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ], [ rdfs:label "Left" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ], [ rdfs:label "Right" ; <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ] ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 7 ; lv2:symbol "in_l" ; lv2:name "Input L" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 8 ; lv2:symbol "out_l" ; lv2:name "Output L" ],
      [ a lv2:InputPort, lv2:AudioPort ; lv2:index 9 ; lv2:symbol "in_r" ; lv2:name "Input R" ],
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 10 ; lv2:symbol "out_r" ; lv2:name "Output R" ] .
